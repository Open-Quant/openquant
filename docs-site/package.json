{
  "name": "openquant-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "stage:rustdoc": "node scripts/stage-rustdoc.mjs",
    "preview": "astro preview",
    "check:links": "node scripts/check-links.mjs",
    "check:api-drift": "python3 ../scripts/generate_api_inventory.py --check",
    "check:python-reference": "../.venv/bin/python3 ../scripts/generate_python_api_reference.py --check",
    "check:content-schema": "node scripts/check-content-schema.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:coverage": "python3 ../scripts/docs/check_coverage.py --check",
    "check:generated-pages": "python3 ../scripts/docs/generate_site_pages.py --check",
    "check:examples": "node scripts/check-doc-examples.mjs",
    "check:python-examples": "node scripts/check-doc-python-examples.mjs",
    "check:docs": "bun run build && bun run stage:rustdoc && bun run test:design && bun run test:accessibility && bun run test:agent-index && bun run test:links && bun run check:links && bun run check:api-drift && bun run check:content-schema && bun run check:contrast && bun run check:coverage && bun run check:generated-pages && bun run check:module-figures && bun run check:examples && bun run check:rust-output && bun run test:python-interpreter && bun run check:python-examples && bun run check:python-reference",
    "test:links": "node --test scripts/tests/check-links.test.mjs",
    "test:agent-index": "node --test scripts/tests/agent-index.test.mjs",
    "test:accessibility": "node --test scripts/tests/document-accessibility.test.mjs scripts/tests/code-scroll-labels.test.mjs",
    "test:design": "node --test scripts/tests/design-system.test.mjs scripts/tests/hero-motion.test.mjs",
    "check:module-figures": "python3 -m unittest discover -s ../scripts/docs/tests -p test_rust_module_figures.py && python3 ../scripts/docs/generate_rust_module_figures.py --check",
    "test:rust-output": "node --test scripts/tests/check-rust-output.test.mjs",
    "check:rust-output": "bun run test:rust-output && node scripts/check-rust-output.mjs",
    "test:python-interpreter": "node --test scripts/tests/python-interpreter.test.mjs"
  },
  "devDependencies": {
    "astro": "^7.4.8",
    "parse5": "7.3.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.10",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
