---
/** Index of the generated Python API reference (see [slug].astro). */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import reference from '../../../data/pythonApiReference.json';
import { inline, summary } from '../../../lib/docstring';
import { PY_REF_BANNER } from '../../../lib/pythonReference';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicModules = reference.modules.filter((m) => !m.import.startsWith('openquant._core.'));
const wrapped = reference.modules.filter((m) => m.import.startsWith('openquant._core.'));
const count = (m: (typeof reference.modules)[number]) =>
  m.functions.length + m.classes.length;
---

<StarlightPage
  frontmatter={{
    title: 'Python API reference',
    description:
      'Public Python API signatures and docstrings, generated from the built extension, shipped stubs and Python sources.',
    status: 'generated',
    banner: { content: PY_REF_BANNER },
  }}
  headings={[
    { depth: 2, slug: 'modules', text: 'Modules' },
    { depth: 2, slug: 'compiled-internals', text: 'Compiled modules behind the wrappers' },
  ]}
>
  <p>
    Import the package as <code>openquant</code>. Modules marked <em>compiled</em> are Rust
    bindings. Their descriptions come from runtime docstrings, as shown by <code>help()</code>;
    their signatures and type annotations come from the shipped <code>.pyi</code> stubs.
    Pure-Python entries use source signatures and docstrings. For the Rust crate itself
    see the <a href={`${base}/api/rust/openquant/`}>rustdoc reference</a>.
  </p>

  <p>
    Start with <a href={`${base}/module-reference/api-task-guide/`}>Find an API by task</a>
    to choose between Python wrappers, native bindings and Rust-only operations.
    Use the tables below when you already know the namespace.
  </p>

  <h2 id="modules">Modules</h2>
  <div class="oq-table-scroll" tabindex="0" role="region" aria-label="Python modules table, scroll horizontally if needed">
  <table>
    <caption>Supported public Python modules</caption>
    <thead><tr><th scope="col">Module</th><th scope="col">Kind</th><th scope="col">Items</th><th scope="col">Summary</th></tr></thead>
    <tbody>
      {
        publicModules.map((m) => (
          <tr>
            <th scope="row"><a href={`${base}/api/python/${m.slug}/`}><code>{m.import}</code></a></th>
            <td>{m.kind}</td>
            <td>{count(m)}</td>
            <td set:html={inline(summary(m.doc))} />
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>

  <h2 id="compiled-internals">Compiled modules behind the wrappers</h2>
  <p>
    These compiled modules have a pure-Python module of the same name in front of them (for
    example <code>openquant.bars</code> wraps <code>openquant._core.bars</code>). The wrappers are
    the supported interface; the compiled functions are listed for completeness.
  </p>
  <ul>
    {
      wrapped.map((m) => (
        <li>
          <a href={`${base}/api/python/${m.slug}/`}><code>{m.import}</code></a> ({count(m)})
        </li>
      ))
    }
  </ul>
</StarlightPage>
